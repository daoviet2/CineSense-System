    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^6.19.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
