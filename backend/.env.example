DATABASE_URL=postgresql://cinesense:cinesense_dev@localhost:5432/cinesense?schema=public
# Integration tests (feat-017). MUST be a different database than DATABASE_URL.
# Host: localhost. Docker Compose overrides this to host `postgres`.
DATABASE_URL_TEST=postgresql://cinesense:cinesense_dev@localhost:5432/cinesense_test?schema=public
# Generate secret with: openssl rand -base64 48
JWT_SECRET=replace-with-a-local-development-secret-min-32-chars-long
JWT_EXPIRES_IN=7d
TMDB_API_KEY=replace-with-your-tmdb-v3-api-key
RECOMMENDATION_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://redis:6379
FRONTEND_ORIGIN=http://localhost:3000
